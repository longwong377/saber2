       whenever one of them moves, so what is here is the Ring at Bone — the
       colours are attributes because styles.css must not pin them. -->
  <svg id="reticle" viewBox="0 0 100 100" aria-hidden="true">
    <circle class="ret-ring" cx="50" cy="50" r="15" stroke="#ffffff"></circle>
    <circle class="ret-dot" cx="50" cy="50" r="1.4" fill="#ffffff"></circle>
    <path class="ret-tick" d="M50 26 v6 M50 68 v6 M26 50 h6 M68 50 h6" stroke="#ffffff"></path>
  </svg>
