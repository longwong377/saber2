    <div class="boot-bar"><i id="boot-fill"></i></div>
    <div id="boot-msg" class="boot-msg">forging blade…</div>
    <!--
      WHY THE BOOT SCREEN CAN NOW SAY WHAT WENT WRONG.

      A player: "for whatever reason the game doesn't want to load on the
      browser I've been playing it on, it works perfectly fine on any other
      browser… it is stuck at forging blade."

      "forging blade…" is the text ABOVE, in the markup, and the first warm-up
      step is a no-op — so a page sitting on it has not reached step one. The
      module graph never ran at all. That happens for reasons this page could
      always see and never showed: one module failing to parse on an older
      engine takes the whole graph with it, a 404 on any file in it does the
      same, and `boot()` had no `.catch`, so anything it threw left the screen
      exactly here, forever, in silence.

      A CLASSIC SCRIPT AND NOT A MODULE, deliberately. A module cannot report
      its own SyntaxError — it never runs — so the reporter has to be parsed by
      a different mechanism than the thing it is watching. This is ES5 on
      purpose for the same reason: it must survive the engine that could not
      read the game.
    -->
    <div id="boot-err" class="boot-err" hidden></div>
    <script>
      (function () {
        var box = document.getElementById('boot-err');
        var msg = document.getElementById('boot-msg');
        var shown = false;
        /**
         * WHAT THIS BROWSER CANNOT DO — asked, not guessed.
         *
         * The first version of this said "A file the game needs did not load"
         * and named src/main.js, which was misleading: for a
         * <script type="module">, a RESOLVE or PARSE failure anywhere in the
         * graph fires `error` on the element exactly as a 404 does. The file
         * was there the whole time; the browser could not build the graph.
         *
         * So the page tests the things it actually needs and names the ones
         * that are missing. `HTMLScriptElement.supports('importmap')` is the
         * one that matters most: import maps are Chrome 89, FIREFOX 108 and
         * SAFARI 16.4, which is a far higher bar than anything else here, and
         * without them `import … from 'three'` resolves to nothing and the
         * whole graph fails at its root.
         *
         * Every syntax probe goes through `new Function`, so a form this engine
         * cannot parse throws where it is caught instead of killing the
         * reporter — which is the whole reason this script is ES5.
         */
        function missing() {
          var out = [];
          var S = window.HTMLScriptElement;
          if (!S || !S.supports) out.push('HTMLScriptElement.supports (2021)');
          else {
            if (!S.supports('module')) out.push('ES modules');
            if (!S.supports('importmap')) out.push('import maps — Chrome 89, Firefox 108, Safari 16.4');
          }
          var probes = [
            ['optional chaining and ??', 'var a = null; return a?.b ?? 1;'],
            ['logical assignment (||=)', 'var a = 0; a ||= 1; return a;'],
            ['class fields', 'class C { x = 1; } return new C().x;'],
            ['private fields', 'class C { #x = 1; get v(){ return this.#x; } } return new C().v;'],
            /* NOT `typeof import` — that is a SyntaxError, not a feature test,
               so it reported "missing dynamic import" on every browser ever
               made, including the Edge 152 it was shown to. `import(…)` inside
               a Function body is the real question and parses only where the
               feature exists. */
            ['dynamic import', 'return typeof (0, function(){ return import("./"); });'],
            ['Object.hasOwn', 'return Object.hasOwn({a:1}, "a");'],
            ['Array.at', 'return [1,2].at(-1);'],
            ['String.replaceAll', 'return "a".replaceAll("a","b");'],
            ['structuredClone', 'return typeof structuredClone;']
          ];
          for (var i = 0; i < probes.length; i++) {
            try { new Function(probes[i][1])(); } catch (e) { out.push(probes[i][0]); }
          }
          try {
            var c = document.createElement('canvas');
            if (!c.getContext('webgl2')) out.push('WebGL2');
          } catch (e) { out.push('WebGL2'); }
          return out;
        }
        /**
         * THE ONE FAILURE THIS PAGE CAN RECOGNISE ON SIGHT.
         *
         * "Failed to resolve module specifier" can only happen here if
         * something is naming a BARE specifier — and nothing this page ships
         * does any more. So the file saying it came out of the browser's cache,
         * from a build that still had the import map this page no longer
         * carries: new HTML, old JavaScript. It is transient and a forced
         * refetch clears it, which is worth saying instead of making the player
         * work it out.
         */
        function looksStale(what) {
          return /Failed to resolve module specifier/i.test(String(what || ''));
        }
        var extra = 0;
        function say(what, where) {
          if (!box) return;
          /* THE FIRST ERROR OWNS THE BOX AND THE REST ARE APPENDED, because
             the second error is often the informative one: the element event
             says only "a module failed", while the TypeError or SyntaxError
             behind it arrives moments later with a message and a line number.
             Dropping everything after the first is how this box spent a day
             saying less than the console did. */
          if (shown) {
            if (extra < 5 && what) {
              extra++;
              box.textContent += '\nAlso: ' + what + (where ? ' \u2014 ' + where : '');
            }
            return;
          }
          shown = true;
          var gaps = [];
          try { gaps = missing(); } catch (e) {}
          box.hidden = false;
          box.textContent = 'The game could not start on this browser.\n\n'
            + what + (where ? '\n' + where : '')
            + '\n\n'
            + (looksStale(what)
                ? 'This browser is running a CACHED OLDER COPY of the game.\n\n'
                  + 'Nothing in the current build names a module the way that error describes, so the\n'
                  + 'file that threw it came out of the cache from an earlier version. The page is new\n'
                  + 'and the JavaScript beside it is not.\n\n'
                  + 'Force a refetch: hold Shift and click Reload, or Ctrl+Shift+R (Cmd+Shift+R on a\n'
                  + 'Mac). If it persists, clear this one site\u2019s data \u2014 your keybinds live there, so\n'
                  + 'copy them out first with Options \u2192 Settings file \u2192 Copy in a browser where it runs.'
                : gaps.length
                ? 'This browser is missing:\n  \u2022 ' + gaps.join('\n  \u2022 ')
                  + '\n\nThat is almost certainly the reason. Updating the browser should fix it.'
                : 'Everything the game tests for is present in this browser, so it is NOT too old.\n'
                  + 'The two things that look like this instead are:\n'
                  + '  \u2022 a half-cached copy — the site was fetched while it was mid-publish, and\n'
                  + '    this browser kept it. Load ' + location.origin + location.pathname + '?v=' + Date.now() + '\n'
                  + '    (a fresh address it cannot have cached), or hard-reload with\n'
                  + '    Ctrl+Shift+R / Cmd+Shift+R.\n'
                  + '  \u2022 a script blocked by an extension or the browser\u2019s own protection.')
            + '\n\n' + navigator.userAgent;
          if (msg) msg.textContent = 'could not start';
          /**
           * THE KEYBINDS RIDE OUT ON THE ERROR PAGE, because the export lives
           * in Options and Options needs the game to boot. A player whose only
           * copy of their bindings is inside the one browser that cannot start
           * the game was told to use a screen they could not reach — this is
           * that screen's job done from here. Paste the blob into Options \u2192
           * Settings file \u2192 Load in a browser where it runs.
           */
          try {
            var blob = {};
            var KEYS = ['saber.settings.v6', 'saber.bindings.v2'];
            for (var i = 0; i < KEYS.length; i++) {
              var raw = localStorage.getItem(KEYS[i]);
              if (raw) blob[KEYS[i]] = JSON.parse(raw);
            }
            if (blob['saber.settings.v6'] || blob['saber.bindings.v2']) {
              blob.v = 1;
              box.textContent += '\n\nYour settings and keybinds, saved in this browser, as text you '
                + 'can carry:\n\n' + JSON.stringify(blob)
                + '\n\nSelect that line, copy it, and paste it into Options \u2192 Settings file \u2192 '
                + 'Load in a browser where the game runs. Nothing is lost.';
            }
          } catch (err2) {}
        }
        /**
         * AND WHEN THE MODULE FAILS, ASK THE NETWORK DIRECTLY.
         *
         * A `<script type="module">` fires the SAME bare `error` event whether
         * its file 404'd, was blocked by an extension, or parsed badly
         * somewhere deep in the graph — the event carries no message and no
         * status, which is why the first version of this said "a file did not
         * load" about a file that was sitting right there.
         *
         * `fetch` is a different mechanism with a different answer: a status
         * tells us the file is served and the fault is in PARSING it, a network
         * error tells us something is stopping the request, and a `type` of
         * text/html where JavaScript should be tells us the host served a 404
         * page with a 200 on it. One request settles what a week of guessing
         * could not.
         */
        /**
         * THE DOCTOR — it stops asking one question and asks all of them.
         *
         * The single-fetch version of this promised "the line below asks the
         * network which it was" and then, on the machine that mattered, the
         * line never came: a fetch that hangs reports nothing, which is the
         * one answer a diagnostic must never give. So:
         *
         *   FIRST it fetches main.js twice — once through the cache, once past
         *   it — and COMPARES. Different bytes is the whole verdict: this
         *   browser built the game from a cached copy of one build against the
         *   page of another, and a hard reload ends it. That is the failure
         *   removing the import map made possible, and the one theory nobody
         *   could prove from the outside.
         *
         *   THEN it walks the module graph file by file, fresh, and names the
         *   first thing wrong with any of them: a status that is not 200, a
         *   body that is a web page where JavaScript belongs (security
         *   software and captive networks answer in the site's place), or a
         *   request that fails outright.
         *
         *   AND A WATCHDOG says so when the network answers nothing at all,
         *   because a held-open request is itself a finding.
         */
        var doctored = false;
        function doctor() {
          if (doctored || !box || !window.fetch || window.SABER) return;
          doctored = true;
          var alive = Date.now();
          function report(line) { alive = Date.now(); box.textContent += '\n' + line; }
          setTimeout(function check() {
            if (Date.now() - alive > 12000) {
              report('No answer from the network in 12 seconds. The requests are being held open, '
                + 'which points at security software or the network between this browser and the '
                + 'site \u2014 not at the game and not at the browser.');
            } else if (!window.SABER) { setTimeout(check, 3000); }
          }, 12500);
          report('\nChecking\u2026');
          var MAIN = new URL('./src/main.js', location.href).href;
          Promise.all([
            fetch(MAIN).then(function (r) { return r.text(); }),
            fetch(MAIN, { cache: 'no-store' }).then(function (r) { return r.text(); })
          ]).then(function (two) {
            if (two[0] !== two[1]) {
              report('FOUND IT: the copy of the game this browser has cached ('
                + two[0].length + ' bytes) is NOT the copy the site serves ('
                + two[1].length + ' bytes). The page is from one build and the JavaScript from '
                + 'another, and mixed builds cannot start.\n\nHold Shift and press Reload '
                + '(Ctrl+Shift+R, \u2318\u21E7R on a Mac). Your keybinds are not touched by that.');
              return;
            }
            walk();
          }, function () { walk(); });
          function walk() {
            var seen = {}, queue = [MAIN], checked = 0, bytes = 0;
            function step() {
              if (!queue.length || checked >= 300) {
                report('Every file of the game arrives from the site and is JavaScript ('
                  + checked + ' files, ' + Math.round(bytes / 1024) + ' KB). So the network and '
                  + 'the files are fine; the failure happens RUNNING one of them in this browser. '
                  + 'Press F12, open the Console, and send over the first red line \u2014 it names '
                  + 'the file and the line number.');
                return;
              }
              var url = queue.shift();
              if (seen[url]) { step(); return; }
              seen[url] = 1;
              fetch(url, { cache: 'no-store' }).then(function (r) {
                if (!r.ok) {
                  report('FOUND IT: ' + url + ' answers HTTP ' + r.status + '.');
                  return;
                }
                return r.text().then(function (body) {
                  checked++; bytes += body.length;
                  if (/^\s*</.test(body)) {
                    report('FOUND IT: ' + url + ' comes back as a WEB PAGE, not JavaScript. '
                      + 'Something between this browser and the site is answering in its place \u2014 '
                      + 'security software, a proxy, or a sign-in network.');
                    return;
                  }
                  /* Comments quote import lines in this codebase, so they are
                     stripped before specifiers are read; only relative paths
                     are followed, which is all this build contains. */
                  var src = body.replace(/\/\*[\s\S]*?\*\//g, '').replace(/^\s*\/\/.*$/gm, '');
                  var re = /(?:^|[\s;})(])(?:import|export)\s*(?:[^;'"()]*?from\s*)?['"]([^'"]+)['"]|import\s*\(\s*['"]([^'"]+)['"]/g;
                  var m;
                  while ((m = re.exec(src))) {
                    var spec = m[1] || m[2];
                    if (!spec || !/^[./]/.test(spec) || !/\.js$/.test(spec)) continue;
                    try {
                      var u = new URL(spec, r.url || url).href;
                      if (u.indexOf(location.origin) === 0 && !seen[u]) queue.push(u);
                    } catch (e2) {}
                  }
                  step();
                });
              }, function (err) {
                report('FOUND IT: the request for ' + url + ' failed outright ('
                  + (err && err.message) + ') \u2014 something is blocking it before it reaches '
                  + 'the site.');
              });
            }
            step();
          }
        }
        window.addEventListener('error', function (e) {
          /* A failed <script>/<img>/<link> fires an error whose target is the
             element, not a message: name the file rather than saying "Script
             error", which is what a cross-origin module reports. */
          var t = e && e.target;
          if (t && t !== window && t.src) {
            var url = t.src;
            say('The browser could not build the game from ' + url + '.',
                'A module script reports the same error for a file that did not arrive and for one '
                + 'that arrived and would not parse, so the lines below check every file directly.');
            doctor();
            return;
          }
          say((e && e.message) || 'A script error with no message.',
              e && e.filename ? e.filename + ':' + e.lineno : '');
          doctor();
        }, true);
        window.addEventListener('unhandledrejection', function (e) {
          var r = e && e.reason;
          say((r && (r.message || r)) + '' || 'A promise failed with no message.', '');
        });
        /* AND THE SILENT CASE: no error fired and nothing started. An import
           map that resolves nothing, a module blocked by an extension, a
           network that stalled — all of them look like this screen forever.
           `window.SABER` is what main.js sets when it has finished. */
        setTimeout(function () {
          if (!window.SABER && !shown) {
            say('It has been 30 seconds and the game has not started, with no error reported.',
                'That usually means a script was blocked — by an extension, or by the browser itself.');
          }
        }, 30000);
      }());
    </script>
  </div>
</div>

<!-- ══════════════════════ LOADING ══════════════════════
